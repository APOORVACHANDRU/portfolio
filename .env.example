# OpenAI API Key - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Atlas - get from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Seed secret - any random string to protect the seed endpoint
SEED_SECRET=your_random_secret_here

# Portfolio owner info
NEXT_PUBLIC_OWNER_NAME="Your Name"
NEXT_PUBLIC_OWNER_TITLE="Full Stack Developer"
NEXT_PUBLIC_OWNER_EMAIL="you@example.com"
NEXT_PUBLIC_GITHUB_URL="https://github.com/yourusername"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/in/yourusername"

# Rate limiting (requests per minute per IP)
RATE_LIMIT_RPM=10
